const SECTIONS = {
  blr:  [["s1","Real HR inbox — email these properly"],
         ["s2","WhatsApp them"],
         ["s3","Outside Bangalore — but real HR inbox"]],
  pune: [["p1","Real HR inbox — email these properly"],
         ["p2","Live opening right now, or WhatsApp them"],
         ["p3","Email / LinkedIn only"]],
  lko:  [["l1","Real HR inbox — email these properly"],
         ["l2","WhatsApp them"],
         ["l3","Email / LinkedIn only"]],
  noida:[["n1","Real HR inbox — email these properly"],
         ["n2","Phone / LinkedIn only"]],
  rem:  [["r1","Remote-friendly — LinkedIn first"]]
};
const TABS = [["blr","Bangalore"],["pune","Pune"],["lko","Lucknow"],["noida","Noida / NCR"],["rem","Remote"]];
const LIVE_KEYS = ["s1","s2","s3","p1","p2","p3"];

let DATA = {};   // section key -> [company, …]
let SOURCE = "bundle";
let FETCHED_AT = null;

/* ------------------------------------------------------------ helpers ---- */
const STAGES = [
  ["none",        "Not contacted"],
  ["contacted",   "Contacted"],
  ["replied",     "Replied"],
  ["interviewing","Interviewing"],
  ["offer",       "Offer"],
  ["rejected",    "Rejected"]
];
const STAGE_LABEL = Object.fromEntries(STAGES);
const STAGE_COLOR = { contacted:"var(--blue)", replied:"var(--violet)",
  interviewing:"var(--amber)", offer:"var(--wa)", rejected:"var(--warn)" };

const rec = (id) => STATE[id] || { stage:"none", at:null, note:"" };
const isDone = (id) => rec(id).stage !== "none";

function ago(ts){
  if(!ts) return "";
  const d = Math.floor((Date.now()-ts)/86400000);
  if(d <= 0) return "today";
  if(d === 1) return "yesterday";
  if(d < 30) return d+" days ago";
  const m = Math.floor(d/30);
  return m === 1 ? "a month ago" : m+" months ago";
}
function needsFollowUp(id){
  const r = rec(id);
  return r.stage === "contacted" && r.at && (Date.now()-r.at) > 7*86400000;
}
function pretty(w){
  const d = String(w).replace(/\D/g,"");
  return d.length === 12 ? "+91 "+d.slice(2,7)+" "+d.slice(7) : "+"+d;
}
function fill(tplStr, companyName){
  return tplStr
    .replace(/\{company\}/g, companyName)
    .replace(/\{name\}/g,    ME.name)
    .replace(/\{role\}/g,    ME.role)
    .replace(/\{years\}/g,   ME.years)
    .replace(/\{stack\}/g,   ME.stack);
}
let toastTimer = null;
function toast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove("show"), 1900);
}
async function copy(text, label){
  try{
    await navigator.clipboard.writeText(text);
    toast(label+" copied");
  }catch(e){
    // Clipboard API needs a secure context; file:// in some browsers is not one.
    const ta = document.createElement("textarea");
    ta.value = text; ta.setAttribute("readonly","");
    ta.style.cssText = "position:fixed;top:-1000px";
    document.body.append(ta); ta.select();
    try{ document.execCommand("copy"); toast(label+" copied"); }
    catch(_){ toast("Copy failed — select it manually"); }
    ta.remove();
  }
}

/* ----------------------------------------------------------- fetching ---- */
const TARGET = "http://147.93.19.196/jobs/";
const PROXIES = [
  { name:"jina",       url:"https://r.jina.ai/"+TARGET, headers:{ "X-Return-Format":"html" } },
  { name:"codetabs",   url:"https://api.codetabs.com/v1/proxy?quest="+encodeURIComponent(TARGET) },
  { name:"allorigins", url:"https://api.allorigins.win/raw?url="+encodeURIComponent(TARGET) }
];

function parseSweep(html){
  const blocks = html.match(/<script\b[^>]*>([\s\S]*?)<\/script>/g) || [];
  const sc = blocks.find(b => b.includes("const DATA") && b.includes("const PUNE"));
  if(!sc) throw new Error("DATA/PUNE block not found");
  const read = (n) => {
    const m = sc.match(new RegExp("const\\s+"+n+"\\s*=\\s*(\\{[\\s\\S]*?\\})\\s*;"));
    if(!m) throw new Error("could not locate "+n);
    // JS object literals, not JSON — DATA uses unquoted keys, so JSON.parse fails.
    return Function('"use strict";return ('+m[1]+")")();
  };
  const merged = { ...read("DATA"), ...read("PUNE") };
  const out = {};
  for(const k of LIVE_KEYS) if(Array.isArray(merged[k])) out[k] = merged[k];
  if(!Object.keys(out).length) throw new Error("no sections parsed");
  return out;
}

async function refresh(quiet){
  const problems = [];
  for(const p of PROXIES){
    try{
      const resp = await fetch(p.url, { headers:p.headers || {} });
      if(!resp.ok) throw new Error("HTTP "+resp.status);
      const live = parseSweep(await resp.text());
      Object.assign(DATA, live);
      SOURCE = "live"; FETCHED_AT = Date.now();
      store.set("cache", { at:FETCHED_AT, data:live });
      render();
      if(!quiet) toast("Updated from live sweep via "+p.name);
      return true;
    }catch(err){ problems.push(p.name+": "+err.message); }
  }
  if(!quiet) toast("Live refresh failed — showing "+SOURCE);
  console.warn("Live refresh failed:", problems.join(" | "));
  render();
  return false;
}

/* ------------------------------------------------------------- filters --- */
const FILTERS = [
  ["hr",   "Has HR inbox",   (c)  => (c.hr||[]).length > 0],
  ["wa",   "Has WhatsApp",   (c)  => (c.wa||[]).length > 0],
  ["job",  "Live opening",   (c)  => !!c.job],
  ["todo", "Not contacted",  (c,i)=> !isDone(i)],
  ["fu",   "Needs follow-up",(c,i)=> needsFollowUp(i)]
];
let active = new Set();
let query = "";
let TAB = store.get("tab") || "blr";
if(!TABS.some(t => t[0] === TAB)) TAB = "blr";

function rowsFor(tab){
  const out = [];
  for(const [key,title] of SECTIONS[tab]){
    const base = (DATA[key] || []).concat(CUSTOM[key] || []);
    out.push([key, title, base]);
  }
  return out;
}
function passes(c){
  const id = idOf(c.n);
  if(query){
    const hay = (c.n+" "+(c.note||"")+" "+(c.hr||[]).join(" ")+" "+(c.em||[]).join(" ")).toLowerCase();
    if(!hay.includes(query)) return false;
  }
  for(const [k,,test] of FILTERS) if(active.has(k) && !test(c,id)) return false;
  return true;
}

/* ------------------------------------------------------------ rendering -- */
function stageButton(id, card){
  const wrap = document.createElement("div");
  wrap.style.cssText = "position:relative;flex:none";
  const b = document.createElement("button");
  b.className = "stage";
  b.dataset.stage = rec(id).stage;
  b.textContent = STAGE_LABEL[rec(id).stage];
  b.setAttribute("aria-label", "Status — click to advance, right-click or long-press for all stages");

  const sel = document.createElement("select");
  sel.setAttribute("aria-label","Set status");
  sel.style.cssText = "position:absolute;inset:0;opacity:0;width:100%;height:100%;cursor:pointer";
  for(const [v,label] of STAGES){
    const o = document.createElement("option");
    o.value = v; o.textContent = label; sel.append(o);
  }
  sel.value = rec(id).stage;
  sel.addEventListener("change", () => setStage(id, sel.value, card, b, sel));

  b.addEventListener("click", (e) => {
    e.preventDefault();
    const order = STAGES.map(s => s[0]);
    const next = order[(order.indexOf(rec(id).stage)+1) % order.length];
    setStage(id, next, card, b, sel);
  });
  wrap.append(b, sel);
  return wrap;
}

function setStage(id, stage, card, btn, sel){
  const r = rec(id);
  STATE[id] = { stage, at: stage === "none" ? null : Date.now(), note: r.note || "" };
  if(stage === "none" && !STATE[id].note) delete STATE[id];
  store.set("state", STATE);
  btn.dataset.stage = stage;
  btn.textContent = STAGE_LABEL[stage];
  if(sel) sel.value = stage;
  card.dataset.stage = stage;
  card.classList.toggle("dim", stage === "rejected");
  paintMeta(id, card);
  count();
  if(active.size) render();   // the card may no longer pass an active filter
}

function paintMeta(id, card){
  const host = card.querySelector(".meta");
  host.textContent = "";
  const r = rec(id);
  if(r.at){
    const s = document.createElement("span");
    s.textContent = STAGE_LABEL[r.stage].toLowerCase()+" "+ago(r.at);
    host.append(s);
  }
  if(needsFollowUp(id)){
    const f = document.createElement("span");
    f.className = "flag"; f.textContent = "follow up";
    host.append(f);
  }
}

function card(c){
  const id = idOf(c.n);
  const el = document.createElement("div");
  el.className = "card";
  el.dataset.stage = rec(id).stage;
  if(rec(id).stage === "rejected") el.classList.add("dim");

  const top = document.createElement("div"); top.className = "top";
  const nm = document.createElement("div"); nm.className = "name"; nm.textContent = c.n;
  top.append(nm, stageButton(id, el));
  el.append(top);

  if(c.note){
    const p = document.createElement("p"); p.className = "note"; p.textContent = c.note;
    el.append(p);
  }
  const meta = document.createElement("div"); meta.className = "meta"; el.append(meta);
  paintMeta(id, el);

  const msg = fill(TPL, c.n);
  const row = document.createElement("div"); row.className = "row";

  (c.hr||[]).forEach(e => {
    const a = document.createElement("a"); a.className = "btn hr";
    a.href = "mailto:"+e+"?subject="+encodeURIComponent(SUBJECT)+"&body="+encodeURIComponent(msg);
    a.textContent = "HR  "+e; row.append(a);
  });
  (c.wa||[]).forEach(w => {
    const a = document.createElement("a"); a.className = "btn wa";
    a.href = "https://wa.me/"+String(w).replace(/\D/g,"")+"?text="+encodeURIComponent(msg);
    a.target = "_blank"; a.rel = "noopener";
    a.textContent = "WhatsApp  "+pretty(w); row.append(a);
  });
  (c.em||[]).forEach(e => {
    const a = document.createElement("a"); a.className = "btn";
    a.href = "mailto:"+e+"?subject="+encodeURIComponent(SUBJECT)+"&body="+encodeURIComponent(msg);
    a.textContent = e; row.append(a);
  });
  if(c.job){
    const a = document.createElement("a"); a.className = "btn";
    a.href = c.job.u; a.target = "_blank"; a.rel = "noopener";
    a.textContent = "↗ "+c.job.t; row.append(a);
  }
  if(c.li){
    const a = document.createElement("a"); a.className = "btn li";
    a.href = /^https?:/.test(c.li) ? c.li : "https://www.linkedin.com/company/"+c.li+"/people/";
    a.target = "_blank"; a.rel = "noopener";
    a.textContent = "in  LinkedIn · People"; row.append(a);
  }

  const all = (c.hr||[]).concat(c.em||[]);
  if(all.length){
    const b = document.createElement("button"); b.className = "btn small";
    b.textContent = "Copy email";
    b.addEventListener("click", () => copy(all.join(", "), "Email"));
    row.append(b);
  }
  const nb = document.createElement("button"); nb.className = "btn small";
  nb.textContent = rec(id).note ? "Note ●" : "Note";
  row.append(nb);
  el.append(row);

  if(c.land){
    const d = document.createElement("div"); d.className = "land";
    d.textContent = "landline "+c.land+"  —  no WhatsApp"; el.append(d);
  }

  const nWrap = document.createElement("div");
  nWrap.className = "notes"; nWrap.hidden = !rec(id).note;
  const ta = document.createElement("textarea");
  ta.placeholder = "What they said, who you spoke to, when to circle back…";
  ta.value = rec(id).note || "";
  ta.setAttribute("aria-label", "Notes for "+c.n);
  ta.addEventListener("input", () => {
    const r = rec(id);
    STATE[id] = { stage:r.stage, at:r.at, note:ta.value };
    if(!ta.value && r.stage === "none") delete STATE[id];
    store.set("state", STATE);
    nb.textContent = ta.value ? "Note ●" : "Note";
  });
  nWrap.append(ta); el.append(nWrap);
  nb.addEventListener("click", () => {
    nWrap.hidden = !nWrap.hidden;
    if(!nWrap.hidden) ta.focus();
  });

  return el;
}

function render(){
  // Tabs
  const tabHost = document.getElementById("tabs");
  tabHost.textContent = "";
  for(const [key,label] of TABS){
    const b = document.createElement("button");
    b.className = "tab"+(key === TAB ? " on" : "");
    b.setAttribute("role","tab");
    b.setAttribute("aria-selected", String(key === TAB));
    b.setAttribute("aria-controls","panels");
    b.textContent = label;
    const n = document.createElement("span");
    n.className = "n";
    n.textContent = rowsFor(key).reduce((s,[,,list]) => s+list.length, 0);
    b.append(n);
    b.addEventListener("click", () => { TAB = key; store.set("tab", key); render(); });
    tabHost.append(b);
  }

  // Chips
  const chipHost = document.getElementById("chips");
  chipHost.textContent = "";
  for(const [k,label] of FILTERS){
    const b = document.createElement("button");
    b.className = "chip"+(active.has(k) ? " on" : "");
    b.textContent = label;
    b.setAttribute("aria-pressed", String(active.has(k)));
    b.addEventListener("click", () => {
      active.has(k) ? active.delete(k) : active.add(k);
      render();
    });
    chipHost.append(b);
  }

  // Panels
  const host = document.getElementById("panels");
  host.textContent = "";
  let shown = 0;
  for(const [key,title,list] of rowsFor(TAB)){
    const keep = list.filter(passes);
    if(!keep.length) continue;
    shown += keep.length;
    const h = document.createElement("h2"); h.textContent = title; host.append(h);
    for(const c of keep) host.append(card(c));
  }
  if(!shown){
    const e = document.createElement("div"); e.className = "empty";
    const total = rowsFor(TAB).reduce((s,[,,l]) => s+l.length, 0);
    e.textContent = total === 0
      ? "Nothing here yet — add your first company with the form below."
      : "No company matches this search and filter combination.";
    host.append(e);
  }

  document.getElementById("add-where").textContent =
    TABS.find(t => t[0] === TAB)[1]+" · "+SECTIONS[TAB][0][1].split(" — ")[0];

  count();
  paintFooter();
}

function count(){
  let done = 0, total = 0, hr = 0, wa = 0, fu = 0;
  const byStage = {};
  for(const [,,list] of rowsFor(TAB)) for(const c of list){
    const id = idOf(c.n); total++;
    const st = rec(id).stage;
    byStage[st] = (byStage[st]||0)+1;
    if(st !== "none") done++;
    if((c.hr||[]).length) hr++;
    wa += (c.wa||[]).length;
    if(needsFollowUp(id)) fu++;
  }
  document.getElementById("c-done").textContent  = done;
  document.getElementById("c-total").textContent = total;
  document.getElementById("c-hr").textContent    = hr;
  document.getElementById("c-wa").textContent    = wa;
  document.getElementById("c-fu").textContent    = fu;

  const bar = document.getElementById("bar");
  bar.textContent = "";
  for(const [key] of STAGES){
    if(key === "none" || !byStage[key]) continue;
    const s = document.createElement("span");
    s.style.width = (byStage[key]/Math.max(total,1)*100)+"%";
    s.style.background = STAGE_COLOR[key];
    s.title = STAGE_LABEL[key]+": "+byStage[key];
    bar.append(s);
  }
  bar.setAttribute("aria-label", done+" of "+total+" contacted");
}

function paintFooter(){
  const f = document.getElementById("foot");
  f.textContent = "";

  const src = document.createElement("p"); src.className = "src";
  const dot = document.createElement("span");
  dot.className = "dot "+(SOURCE === "live" ? "live" : SOURCE === "cache" ? "cache" : "bundle");
  src.append(dot);
  const txt = document.createElement("span");
  txt.textContent =
    SOURCE === "live"  ? "Bangalore & Pune: live from the sweep, fetched "+ago(FETCHED_AT) :
    SOURCE === "cache" ? "Bangalore & Pune: cached copy from "+ago(FETCHED_AT)+" — live fetch failed" :
                         "Bangalore & Pune: bundled copy — no live fetch yet";
  src.append(txt);
  const rb = document.createElement("button");
  rb.className = "btn small"; rb.textContent = "↻ Refresh now";
  rb.addEventListener("click", () => { rb.textContent = "↻ Fetching…"; refresh(false).then(()=>{}); });
  src.append(rb);
  f.append(src);

  const p = document.createElement("p");
  p.append(document.createTextNode(
    "Lucknow, Noida and Remote are researched and bundled — only contacts actually published on each "+
    "company's own site are listed. Nothing is guessed: a bounce from your Gmail hurts the deliverability "+
    "of the applications that matter. Status, notes and added companies are saved on this device only — "+
    "use Export before switching machines."
  ));
  f.append(p);

  const links = document.createElement("p");
  for(const [label,href] of [["Portfolio",ME.folio],["GitHub",ME.github],["LinkedIn",ME.linkedin],["Résumé",ME.resume]]){
    const a = document.createElement("a");
    a.href = href; a.target = "_blank"; a.rel = "noopener";
    a.textContent = label; a.style.cssText = "color:var(--accent);margin-right:12px";
    links.append(a);
  }
  f.append(links);
}

/* --------------------------------------------------------------- wiring -- */
document.getElementById("sub").textContent =
  ME.name+" · "+ME.role+" · "+ME.years+" yrs · "+ME.target;

const tplBox = document.getElementById("tpl");
tplBox.value = TPL;
tplBox.addEventListener("input", () => { TPL = tplBox.value; store.set("tpl", TPL); render(); });
document.getElementById("copytpl").addEventListener("click", () => copy(TPL, "Message"));
document.getElementById("resettpl").addEventListener("click", () => {
  TPL = DEFAULT_TPL; tplBox.value = TPL; store.set("tpl", TPL); render(); toast("Message reset");
});

const qBox = document.getElementById("q");
qBox.addEventListener("input", () => { query = qBox.value.trim().toLowerCase(); render(); });

document.getElementById("add").addEventListener("click", () => {
  const n = document.getElementById("f-n").value.trim();
  if(!n){ toast("Company name is required"); document.getElementById("f-n").focus(); return; }
  const split = (id) => document.getElementById(id).value.split(",").map(s => s.trim()).filter(Boolean);
  const key = SECTIONS[TAB][0][0];
  const entry = {
    n, hr:split("f-hr"), em:split("f-em"),
    wa:split("f-wa").map(w => w.replace(/\D/g,"")).filter(Boolean),
    li:document.getElementById("f-li").value.trim(),
    note:document.getElementById("f-note").value.trim()
  };
  CUSTOM[key] = (CUSTOM[key] || []).concat([entry]);
  store.set("custom", CUSTOM);
  for(const id of ["f-n","f-hr","f-em","f-wa","f-li","f-note"]) document.getElementById(id).value = "";
  render();
  toast(n+" added");
});

document.getElementById("export").addEventListener("click", () => {
  const blob = new Blob([JSON.stringify({
    v:1, exported:new Date().toISOString(), state:STATE, custom:CUSTOM, tpl:TPL
  }, null, 2)], { type:"application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "outreach-"+new Date().toISOString().slice(0,10)+".json";
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  toast("Exported "+Object.keys(STATE).length+" records");
});

document.getElementById("import").addEventListener("click", () => document.getElementById("file").click());
document.getElementById("file").addEventListener("change", (e) => {
  const file = e.target.files && e.target.files[0];
  if(!file) return;
  const r = new FileReader();
  r.onload = () => {
    let incoming;
    try{ incoming = JSON.parse(r.result); }
    catch(_){ toast("That file isn't valid JSON"); return; }
    if(!incoming || typeof incoming !== "object" || !incoming.state){
      toast("No progress found in that file"); return;
    }
    // Merge, newest wins — never clobber a record the import doesn't mention.
    let n = 0;
    for(const [id,r2] of Object.entries(incoming.state)){
      if(!r2 || typeof r2 !== "object") continue;
      const mine = STATE[id];
      if(!mine || (r2.at||0) >= (mine.at||0)){ STATE[id] = r2; n++; }
    }
    if(incoming.custom && typeof incoming.custom === "object"){
      for(const [k,list] of Object.entries(incoming.custom)){
        if(!Array.isArray(list)) continue;
        const have = new Set((CUSTOM[k]||[]).map(c => idOf(c.n)));
        CUSTOM[k] = (CUSTOM[k]||[]).concat(list.filter(c => c && c.n && !have.has(idOf(c.n))));
      }
    }
    if(typeof incoming.tpl === "string" && incoming.tpl){ TPL = incoming.tpl; tplBox.value = TPL; }
    store.set("state", STATE); store.set("custom", CUSTOM); store.set("tpl", TPL);
    render();
    toast("Imported "+n+" record"+(n === 1 ? "" : "s"));
  };
  r.readAsText(file);
  e.target.value = "";
});

const THEMES = [["auto","◐ Auto"],["light","☀ Light"],["dark","☾ Dark"]];
let theme = store.get("theme") || "auto";
function applyTheme(){
  const btn = document.getElementById("theme");
  if(theme === "auto") document.documentElement.removeAttribute("data-theme");
  else document.documentElement.setAttribute("data-theme", theme);
  btn.textContent = (THEMES.find(t => t[0] === theme) || THEMES[0])[1];
}
document.getElementById("theme").addEventListener("click", () => {
  const i = THEMES.findIndex(t => t[0] === theme);
  theme = THEMES[(i+1) % THEMES.length][0];
  store.set("theme", theme); applyTheme();
});
applyTheme();

/* ----------------------------------------------------------- boot ------- */
DATA = Object.assign({}, BUNDLED, SEED);
SOURCE = "bundle";
const cached = store.get("cache");
if(cached && cached.data){
  Object.assign(DATA, cached.data);
  SOURCE = "cache"; FETCHED_AT = cached.at;
}
render();
refresh(true);   // always re-pull Bangalore & Pune from the live sweep
</script>
</body>
</html>
