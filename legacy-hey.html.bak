<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Outreach — Mohd Suhel</title>
<style>
  :root{
    --bg:#f7f6f3; --card:#fff; --ink:#16181d; --mute:#5d636e; --line:#e2e0da;
    --accent:#1d6b3f; --accent-soft:#e8f2ec; --wa:#1f8a4c; --warn:#a3271f; --chip:#eeece6;
    --blue:#0a66c2; --amber:#8a6100; --amber-soft:#f6efdc; --violet:#5b3fa8;
    --shadow:0 1px 2px rgba(16,18,22,.05);
  }
  :root:not([data-theme="light"]){ }
  @media (prefers-color-scheme:dark){ :root:not([data-theme="light"]){
    --bg:#14161a; --card:#1c1f25; --ink:#e9eaec; --mute:#9aa1ac; --line:#2c313a;
    --accent:#5fbd88; --accent-soft:#1d2a23; --wa:#4cc47c; --warn:#e5837a; --chip:#252a32;
    --blue:#5aa9f0; --amber:#d7b45e; --amber-soft:#2b2416; --violet:#a992e8;
    --shadow:none;
  }}
  :root[data-theme="dark"]{
    --bg:#14161a; --card:#1c1f25; --ink:#e9eaec; --mute:#9aa1ac; --line:#2c313a;
    --accent:#5fbd88; --accent-soft:#1d2a23; --wa:#4cc47c; --warn:#e5837a; --chip:#252a32;
    --blue:#5aa9f0; --amber:#d7b45e; --amber-soft:#2b2416; --violet:#a992e8;
    --shadow:none;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    -webkit-text-size-adjust:100%}
  .wrap{max-width:820px;margin:0 auto;padding:18px 14px 70px}

  header{display:flex;align-items:flex-start;gap:12px}
  header .hgrow{flex:1;min-width:0}
  header h1{font-size:21px;margin:0 0 4px;letter-spacing:-.2px}
  header p{margin:0;color:var(--mute);font-size:12.5px}
  .iconbtn{background:var(--card);border:1px solid var(--line);color:var(--mute);
    border-radius:9px;min-width:44px;height:38px;padding:0 10px;font:inherit;font-size:13px;
    cursor:pointer;flex:none}
  .iconbtn:hover{color:var(--ink)}

  .bar{height:8px;border-radius:99px;background:var(--chip);overflow:hidden;display:flex;margin:16px 0 9px}
  .bar span{display:block;height:100%}

  .stats{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 4px}
  .stat{background:var(--chip);border-radius:7px;padding:6px 10px;font-size:12px;color:var(--mute)}
  .stat b{color:var(--ink);font-variant-numeric:tabular-nums}

  .toolbar{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0 0}
  .search{flex:1;min-width:180px;background:var(--card);border:1px solid var(--line);
    color:var(--ink);border-radius:9px;padding:10px 12px;font:inherit;font-size:14px;min-height:44px}
  .search::placeholder{color:var(--mute)}
  .chips{display:flex;gap:6px;flex-wrap:wrap;margin:9px 0 0}
  .chip{background:var(--card);border:1px solid var(--line);color:var(--mute);border-radius:99px;
    padding:7px 12px;font:inherit;font-size:12.5px;cursor:pointer;min-height:34px}
  .chip.on{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}

  .tabs{display:flex;gap:7px;margin:16px 0 2px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
  .tabs::-webkit-scrollbar{display:none}
  .tab{flex:1 0 auto;background:var(--card);border:1px solid var(--line);color:var(--mute);
    border-radius:9px;padding:11px 14px;font:inherit;font-size:14px;font-weight:600;cursor:pointer;
    white-space:nowrap;min-height:44px}
  .tab.on{background:var(--accent);border-color:var(--accent);color:#fff}
  .tab .n{font-weight:500;opacity:.7;font-size:12px;margin-left:4px;font-variant-numeric:tabular-nums}

  h2{font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:var(--mute);
    margin:26px 0 10px;font-weight:600}

  .card{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--line);
    border-radius:11px;padding:13px 14px;margin-bottom:9px;box-shadow:var(--shadow)}
  .card.dim{opacity:.5}
  .card[data-stage="contacted"]{border-left-color:var(--blue)}
  .card[data-stage="replied"]{border-left-color:var(--violet)}
  .card[data-stage="interviewing"]{border-left-color:var(--amber)}
  .card[data-stage="offer"]{border-left-color:var(--wa)}
  .card[data-stage="rejected"]{border-left-color:var(--warn)}
  .top{display:flex;align-items:flex-start;gap:10px}
  .name{font-weight:650;font-size:15.5px;flex:1;line-height:1.3;min-width:0;overflow-wrap:anywhere}
  .note{color:var(--mute);font-size:12.5px;margin:5px 0 0;overflow-wrap:anywhere}
  .meta{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:7px;font-size:11.5px;color:var(--mute)}
  .flag{background:var(--amber-soft);color:var(--amber);border-radius:6px;padding:3px 7px;font-weight:600}

  .stage{border:1px solid var(--line);background:var(--bg);color:var(--mute);border-radius:99px;
    padding:6px 11px;font:inherit;font-size:12px;font-weight:650;cursor:pointer;flex:none;min-height:34px}
  .stage[data-stage="contacted"]{border-color:var(--blue);color:var(--blue)}
  .stage[data-stage="replied"]{border-color:var(--violet);color:var(--violet)}
  .stage[data-stage="interviewing"]{border-color:var(--amber);color:var(--amber)}
  .stage[data-stage="offer"]{background:var(--wa);border-color:var(--wa);color:#fff}
  .stage[data-stage="rejected"]{border-color:var(--warn);color:var(--warn)}

  .row{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
  a.btn,button.btn{display:inline-flex;align-items:center;gap:6px;text-decoration:none;
    border:1px solid var(--line);border-radius:8px;padding:9px 11px;font:inherit;font-size:13.5px;
    color:var(--ink);background:var(--bg);font-weight:500;cursor:pointer;min-height:40px}
  a.btn:active,button.btn:active{transform:scale(.97)}
  a.wa{background:var(--wa);border-color:var(--wa);color:#fff}
  a.li{background:var(--blue);border-color:var(--blue);color:#fff}
  a.hr{background:var(--accent-soft);border-color:var(--accent);color:var(--accent);font-weight:650}
  .btn.small{font-size:12.5px;padding:7px 10px;min-height:34px}
  .land{font-size:12.5px;color:var(--mute);margin-top:8px}

  .notes{margin-top:9px}
  .notes textarea{width:100%;background:var(--bg);border:1px solid var(--line);color:var(--ink);
    border-radius:8px;padding:9px 10px;font:inherit;font-size:13px;resize:vertical;min-height:64px}

  .panel{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:14px;box-shadow:var(--shadow)}
  .panel textarea{width:100%;background:var(--bg);border:1px solid var(--line);color:var(--ink);
    border-radius:8px;padding:10px;font:inherit;font-size:13.5px;line-height:1.55;resize:vertical;min-height:110px}
  .panel .rules{color:var(--mute);font-size:12.5px;margin:10px 0 0}
  .hint{color:var(--mute);font-size:12px;margin:8px 0 0}
  .hint code{background:var(--chip);border-radius:4px;padding:1px 5px;font-size:11.5px}

  .form{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
  .form input{background:var(--bg);border:1px solid var(--line);color:var(--ink);border-radius:8px;
    padding:10px;font:inherit;font-size:13.5px;min-height:44px;min-width:0}
  .form .full{grid-column:1/-1}
  @media (max-width:520px){ .form{grid-template-columns:1fr} }

  .empty{color:var(--mute);font-size:13.5px;line-height:1.6;background:var(--card);
    border:1px dashed var(--line);border-radius:11px;padding:22px 16px;text-align:center}
  .src{font-size:11.5px;color:var(--mute);margin:9px 0 0;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .dot{width:7px;height:7px;border-radius:99px;background:var(--mute);flex:none}
  .dot.live{background:var(--wa)} .dot.cache{background:var(--amber)} .dot.bundle{background:var(--warn)}

  footer{margin-top:32px;color:var(--mute);font-size:12px;line-height:1.6}
  footer code{background:var(--chip);border-radius:4px;padding:1px 5px}

  .toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--ink);
    color:var(--bg);padding:10px 16px;border-radius:9px;font-size:13.5px;font-weight:500;
    opacity:0;pointer-events:none;transition:opacity .18s;z-index:50;max-width:90vw}
  .toast.show{opacity:1}

  :focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  @media (prefers-reduced-motion:reduce){ *{transition:none!important} }
</style>
</head>
<body>
<div class="wrap">

<header>
  <div class="hgrow">
    <h1>Outreach tracker</h1>
    <p id="sub"></p>
  </div>
  <button class="iconbtn" id="theme" title="Theme">◐ Auto</button>
</header>

<div class="bar" id="bar" role="img" aria-label="Pipeline progress"></div>
<div class="stats">
  <div class="stat"><b id="c-done">0</b> / <b id="c-total">0</b> contacted</div>
  <div class="stat"><b id="c-hr">0</b> HR inboxes</div>
  <div class="stat"><b id="c-wa">0</b> WhatsApp</div>
  <div class="stat"><b id="c-fu">0</b> need follow-up</div>
</div>

<div class="toolbar">
  <input class="search" id="q" type="search" placeholder="Search company or note…" aria-label="Search companies">
  <button class="iconbtn" id="export" title="Download progress as JSON">↓ Export</button>
  <button class="iconbtn" id="import" title="Load progress from JSON">↑ Import</button>
  <input type="file" id="file" accept="application/json,.json" hidden>
</div>
<div class="chips" id="chips" role="group" aria-label="Filters"></div>

<div class="tabs" id="tabs" role="tablist"></div>
<div id="panels"></div>

<h2>The message</h2>
<div class="panel">
  <textarea id="tpl" aria-label="Outreach message template" spellcheck="false"></textarea>
  <div class="row">
    <button class="btn small" id="copytpl">Copy message</button>
    <button class="btn small" id="resettpl">Reset to default</button>
  </div>
  <p class="hint">Tokens: <code>{company}</code> <code>{role}</code> <code>{name}</code> <code>{years}</code> <code>{stack}</code> — filled per card in every WhatsApp and email link.</p>
  <p class="rules">
    Ask before sending the resume — don’t open with an attachment.<br>
    One message per company. No follow-up if there’s no reply.<br>
    Mon–Fri, 10am–6pm only.<br>
    Most numbers are sales lines — if redirected, ask who handles hiring.
  </p>
</div>

<h2>Add a company</h2>
<div class="panel">
  <div class="form">
    <input id="f-n" class="full" placeholder="Company name *" aria-label="Company name">
    <input id="f-hr" placeholder="HR email(s), comma separated" aria-label="HR emails">
    <input id="f-em" placeholder="General email(s)" aria-label="General emails">
    <input id="f-wa" placeholder="WhatsApp, e.g. 919876543210" aria-label="WhatsApp numbers">
    <input id="f-li" placeholder="LinkedIn company handle" aria-label="LinkedIn handle">
    <input id="f-note" class="full" placeholder="Note — why they’re worth contacting" aria-label="Note">
  </div>
  <div class="row"><button class="btn" id="add">Add to <span id="add-where">…</span></button></div>
</div>

<footer id="foot"></footer>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
"use strict";

/* ---------------------------------------------------------------- me ---- */
const ME = {
  name:    "Mohd Suhel",
  role:    "Full-stack developer (React / Node)",
  years:   "2",
  company: "Jamtech Technologies",
  stack:   "React, Next.js, React Native, Node, Express, MongoDB",
  ai:      "AI workflows, agent pipelines and vector search",
  target:  "Full-stack / MERN / AI-integrated, 1–3 yr band",
  email:   "mohdsuhel.dev@gmail.com",
  phone:   "919519838720",
  linkedin:"https://www.linkedin.com/in/mohd-suhel-4b2072257",
  github:  "https://github.com/Suheldevs",
  folio:   "https://mohdsuhel.netlify.app/",
  resume:  "https://drive.google.com/file/d/1_-uaMxN4XP4evy416qIrA0HlUv5YKWti/view?usp=sharing",
  notice:  "30 days"
};

const DEFAULT_TPL =
"Hello, I am {name} — a full-stack developer with {years} years' experience, currently at " +
"Jamtech Technologies. I work on AI-integrated systems: AI workflows, agent pipelines and " +
"vector-search features, built on React / Next.js / Node. I wanted to check if {company} has " +
"an opening for a full-stack or AI-focused developer. May I send my resume here?";

const SUBJECT = "Full-stack / AI developer (2 yrs, React · Node) — application";

/* ------------------------------------------------------------ storage ---- */
const K = "outreach:v1:";
const store = {
  get(k){ try{ const v = localStorage.getItem(K+k); return v===null?null:JSON.parse(v); }catch(e){ return null; } },
  set(k,v){ try{ localStorage.setItem(K+k, JSON.stringify(v)); return true; }catch(e){ return false; } },
  del(k){ try{ localStorage.removeItem(K+k); }catch(e){} }
};

/* Stable id: slug of the name. Live-fetched rows carry no id of their own, so
   the name is the only identity available — slugging means capitalisation and
   punctuation drift don't orphan a card's status and notes. */
const idOf = (name) => String(name).toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");

let STATE = store.get("state") || {};      // id -> {stage, at, note}
let CUSTOM = store.get("custom") || {};    // tabKey -> [company, …]
let TPL = store.get("tpl") || DEFAULT_TPL;

/* --------------------------------------------------------------- data ---- */
